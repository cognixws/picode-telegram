{
  "id": "telegram",
  "name": "Telegram",
  "version": "0.1.1",
  "apiVersion": 3,
  "publisher": "COGNIX[WS]",
  "description": "Receive questions and results, answer your Inbox and talk to your agents from one private Telegram chat.",
  "channel": {
    "name": "Telegram",
    "statusPath": "/status"
  },
  "process": {
    "command": "node",
    "args": [
      "${extensionDir}/server/main.mjs"
    ],
    "settingsCheck": "/settings/check"
  },
  "activation": {
    "instance": true
  },
  "permissions": [
    "agents:read",
    "inbox:read",
    "inbox:answer",
    "messages:read",
    "messages:owner"
  ],
  "settings": [
    {
      "key": "bot_token",
      "label": "Bot token",
      "type": "secret",
      "description": "The BotFather token. Stored protected on this computer."
    },
    {
      "key": "full_text",
      "label": "Include message text",
      "type": "boolean",
      "default": false,
      "description": "Send masked message bodies as well as titles. Long text is shortened."
    }
  ],
  "storage": {
    "migrations": "migrations"
  },
  "ui": {
    "pages": [
      {
        "id": "setup",
        "title": "Telegram",
        "path": "ui/setup.html"
      }
    ]
  },
  "icon": "ui/telegram.svg"
}

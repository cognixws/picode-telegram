{
  "id": "telegram",
  "name": "Telegram",
  "version": "0.4.0",
  "apiVersion": 4,
  "publisher": "COGNIX[WS]",
  "description": "Receive questions, talk to agents and Assistants, and allow channel tools in one private Telegram chat.",
  "channel": {
    "name": "Telegram",
    "statusPath": "/status",
    "protocol": 2,
    "sendPath": "/v2/send",
    "receiptPath": "/v2/receipt",
    "textSetting": "full_text"
  },
  "process": {
    "command": "node",
    "args": [
      "${extensionDir}/server/main.mjs"
    ],
    "settingsCheck": "/settings/check"
  },
  "activation": {
    "instance": true
  },
  "permissions": [
    "agents:read",
    "inbox:read",
    "inbox:answer",
    "messages:read",
    "messages:owner",
    "channels:send",
    "assistants:read",
    "assistants:message"
  ],
  "settings": [
    {
      "key": "bot_token",
      "label": "Bot token",
      "type": "secret",
      "description": "The BotFather token. Stored protected on this computer."
    },
    {
      "key": "full_text",
      "label": "Include message text",
      "type": "boolean",
      "default": false,
      "description": "Send masked message bodies as well as titles. Required for Assistant conversations and channel tools. Long notices are shortened."
    }
  ],
  "storage": {
    "migrations": "migrations"
  },
  "ui": {
    "pages": [
      {
        "id": "setup",
        "title": "Telegram",
        "path": "ui/setup.html"
      }
    ]
  },
  "icon": "ui/telegram.svg"
}
